<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Community Toolkit -->
    <PackageVersion Include="CommunityToolkit.Maui" Version="16.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- IoT and Device Bindings -->
    <PackageVersion Include="Iot.Device.Bindings" Version="4.2.0" />
    <PackageVersion Include="System.Device.Gpio" Version="4.2.0" />
    <!-- Noetix Bumi robot (built from the community binding repo into ./local-nuget) -->
    <PackageVersion Include="Noetix.Sdk.Bumi" Version="3.1.0-preview.1" />
    <!-- MQTT -->
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <!-- Microsoft AspNetCore -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Microsoft Cognitive Services -->
    <PackageVersion Include="Microsoft.CognitiveServices.Speech" Version="1.53.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <!-- Microsoft MAUI -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.130" />
    <!-- Microsoft Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Microsoft Web and Windows -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- winapp CLI：让 `dotnet run` 以包标识启动打包的 WinUI 应用 -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <!-- Audio -->
    <PackageVersion Include="NAudio" Version="3.3.0" />
    <PackageVersion Include="OpusSharp" Version="1.6.8" />
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageVersion Include="SoundFlow" Version="1.4.2" />
    <PackageVersion Include="SoundFlow.Extensions.WebRtc.Apm" Version="1.4.2" />
    <!-- QR Code and Images -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.Skottie" Version="4.156.0" />
    <!-- System -->
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <!-- UI Extensions -->
    <PackageVersion Include="WinUIEx" Version="2.9.3" />
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>