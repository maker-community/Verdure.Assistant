<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Community Toolkit -->
    <PackageVersion Include="CommunityToolkit.Maui" Version="14.0.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- IoT and Device Bindings -->
    <PackageVersion Include="Iot.Device.Bindings" Version="4.2.0" />
    <PackageVersion Include="System.Device.Gpio" Version="4.2.0" />
    <!-- MQTT -->
    <PackageVersion Include="MQTTnet" Version="5.1.0.1559" />
    <!-- Microsoft AspNetCore -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!-- Microsoft Cognitive Services -->
    <PackageVersion Include="Microsoft.CognitiveServices.Speech" Version="1.50.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <!-- Microsoft MAUI -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.51" />
    <!-- Microsoft Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Microsoft Web and Windows -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageVersion Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <!-- Audio -->
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="OpusSharp" Version="1.6.7" />
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageVersion Include="SoundFlow" Version="1.4.1" />
    <PackageVersion Include="SoundFlow.Extensions.WebRtc.Apm" Version="1.4.0" />
    <!-- QR Code and Images -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SkiaSharp" Version="3.116.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageVersion Include="SkiaSharp.Skottie" Version="3.116.1" />
    <!-- System -->
    <PackageVersion Include="System.Text.Json" Version="10.0.8" />
    <!-- UI Extensions -->
    <PackageVersion Include="WinUIEx" Version="2.9.0" />
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>