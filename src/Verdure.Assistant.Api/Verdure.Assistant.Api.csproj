<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ModelFiles\keyword_cortana.table" />
    <None Remove="ModelFiles\keyword_xiaodian.table" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModelFiles\keyword_cortana.table">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelFiles\keyword_xiaodian.table">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"  />
    <PackageReference Include="Microsoft.Extensions.Hosting"  />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"  />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"  />
    <PackageReference Include="SkiaSharp"  />
    <PackageReference Include="SkiaSharp.Skottie"  />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux"  />
    <PackageReference Include="System.Device.Gpio"  />
    <PackageReference Include="Iot.Device.Bindings"  />
    <PackageReference Include="SixLabors.ImageSharp"  />
    <PackageReference Include="QRCoder"  />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verdure.Assistant.Core\Verdure.Assistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
