<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Verdure.Assistant.MAUI.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Verdure.Assistant.ViewModels;assembly=Verdure.Assistant.ViewModels"
             x:DataType="vm:HomePageViewModel"
             Title="语音对话"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ScrollView>
        <Grid Padding="16" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 状态显示区域 -->
            <Frame Grid.Row="0" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                   CornerRadius="15"
                   HasShadow="True"
                   Padding="16">
                <StackLayout Spacing="12">
                    <!-- 连接状态 -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" 
                               Text="🔗 连接状态:" 
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" 
                               Text="{Binding IsConnected, Converter={StaticResource BoolToStringConverter}, ConverterParameter='已连接|未连接'}"
                               VerticalOptions="Center"
                               Margin="8,0,0,0" />
                        <ActivityIndicator Grid.Column="2" 
                                         IsRunning="{Binding IsConnecting}"
                                         IsVisible="{Binding IsConnecting}"
                                         Color="{StaticResource Primary}"
                                         WidthRequest="20"
                                         HeightRequest="20" />
                    </Grid>

                    <!-- 系统状态 -->
                    <Label Text="{Binding SystemStatusText, StringFormat='📊 {0}'}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                    <!-- TTS状态 -->
                    <Label Text="{Binding TtsText, StringFormat='🔊 {0}'}"
                           FontSize="14"
                           IsVisible="{Binding TtsText, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           MaxLines="2"
                           LineBreakMode="TailTruncation" />
                </StackLayout>
            </Frame>

            <!-- 音乐播放器控制区域 -->
            <Frame Grid.Row="1" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                   CornerRadius="15"
                   HasShadow="True"
                   Padding="16">
                <StackLayout Spacing="12">
                    <Label Text="🎵 音乐播放" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <!-- 歌曲信息 -->
                    <StackLayout Spacing="4" IsVisible="{Binding CurrentSongName, Converter={StaticResource StringToBoolConverter}}">
                        <Label Text="{Binding CurrentSongName}" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding CurrentArtist}" 
                               FontSize="14" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               MaxLines="1"
                               LineBreakMode="TailTruncation" />
                    </StackLayout>

                    <!-- 播放进度 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding CurrentSongName, Converter={StaticResource StringToBoolConverter}}">
                        <Label Grid.Column="0" 
                               Text="{Binding MusicPosition, Converter={StaticResource TimeSpanToStringConverter}}"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Slider Grid.Column="1" 
                                Minimum="0"
                                Maximum="{Binding MusicDuration}"
                                Value="{Binding MusicPosition}"
                                Margin="8,0"
                                ThumbColor="{StaticResource Primary}"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        <Label Grid.Column="2" 
                               Text="{Binding MusicDuration, Converter={StaticResource TimeSpanToStringConverter}}"
                               FontSize="12"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- 播放控制按钮 -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Button Grid.Column="0" 
                                Text="⏮️" 
                                FontSize="20"
                                Command="{Binding PreviousMusicCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="50" />
                        <Button Grid.Column="1" 
                                Text="{Binding MusicStatus, Converter={StaticResource MusicStatusToPlayPauseConverter}}" 
                                FontSize="24"
                                Command="{Binding PauseMusicCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="50" />
                        <Button Grid.Column="2" 
                                Text="⏭️" 
                                FontSize="20"
                                Command="{Binding NextMusicCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="50" />
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- 对话消息列表 -->
            <Frame Grid.Row="2" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                   CornerRadius="15"
                   HasShadow="True"
                   Padding="0"
                   MinimumHeightRequest="300">
                <Grid>
                    <CollectionView ItemsSource="{Binding Messages}"
                                  BackgroundColor="Transparent">
                        <CollectionView.Header>
                            <StackLayout Padding="16,16,16,8">
                                <Label Text="💬 对话记录" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </StackLayout>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,4">
                                    <Frame BackgroundColor="{Binding IsError, Converter={StaticResource BoolToMessageBackgroundConverter}}"
                                           CornerRadius="12"
                                           Padding="12,8"
                                           HasShadow="False">
                                        <StackLayout Spacing="4">
                                            <Label Text="{Binding Content}" 
                                                   FontSize="14"
                                                   TextColor="{Binding IsError, Converter={StaticResource BoolToMessageTextColorConverter}}" />
                                            <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss}'}" 
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   HorizontalOptions="End" />
                                        </StackLayout>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- 空状态显示 -->
                    <StackLayout IsVisible="{Binding Messages.Count, Converter={StaticResource IntToBoolInverseConverter}}"
                               VerticalOptions="Center"
                               Padding="20">
                        <Label Text="🤖" 
                               FontSize="48"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="还没有对话消息"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               Margin="0,8,0,0" />
                        <Label Text="点击下方麦克风开始对话"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- 文本输入区域 -->
            <Frame Grid.Row="3" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                   CornerRadius="15"
                   HasShadow="True"
                   Padding="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" 
                           Text="{Binding MessageText}"
                           Placeholder="输入消息..."
                           BackgroundColor="Transparent"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" 
                            Text="📤"
                            FontSize="20"
                            Command="{Binding SendMessageCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40" />
                </Grid>
            </Frame>

            <!-- 语音控制区域 -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
                <!-- 清空按钮 -->
                <Button Grid.Column="0" 
                        Text="🗑️ 清空"
                        Command="{Binding ClearMessagesCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        CornerRadius="25"
                        HeightRequest="50" />

                <!-- 主要录音按钮 -->
                <Border Grid.Column="1" 
                        StrokeThickness="3"
                        Stroke="{Binding IsManualRecording, Converter={StaticResource BoolToRecordingBorderConverter}}"
                        BackgroundColor="{Binding IsManualRecording, Converter={StaticResource BoolToRecordingBackgroundConverter}}"
                        WidthRequest="80"
                        HeightRequest="80">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerPressed="OnRecordingPressed" 
                                                PointerReleased="OnRecordingReleased" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding IsManualRecording, Converter={StaticResource BoolToRecordingTextConverter}}"
                           FontSize="32"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="White" />
                </Border>

                <!-- 服务状态按钮 -->
                <Button Grid.Column="2" 
                        Text="{Binding IsConnected, Converter={StaticResource BoolToServiceStatusConverter}}"
                        Command="{Binding ToggleConnectionCommand}"
                        BackgroundColor="{Binding IsConnected, Converter={StaticResource BoolToServiceBackgroundConverter}}"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50" />
            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>
