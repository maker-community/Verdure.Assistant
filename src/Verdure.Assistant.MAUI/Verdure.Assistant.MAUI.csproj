<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Verdure.Assistant</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- App Identifier -->
		<ApplicationId>com.verdureassistant.mauiapp</ApplicationId>

		<!-- Display Version -->
		<ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">android-arm</RuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\Images\appicon.svg" ForegroundFile="Resources\Images\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\appiconfg.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" Exclude="Resources\Images\appicon.svg;Resources\Images\appiconfg.svg" />
		<MauiImage Update="Resources\Images\angry.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\confident.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\confused.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\cool.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\crying.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\delicious.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />
		<MauiImage Update="Resources\Images\embarrassed.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\funny.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\happy.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\laughing.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\loving.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\neutral.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\relaxed.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\sad.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\shocked.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\silly.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\sleepy.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\surprised.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\thinking.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		<MauiImage Update="Resources\Images\winking.gif">
		  <LogicalName>%(Filename)%(Extension)</LogicalName>
		</MauiImage>
		
		<!-- Emotion GIFs as raw assets to preserve animation -->
		<MauiAsset Include="Resources\Images\Emotions\*.gif" LogicalName="%(Filename)%(Extension)" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <MauiImage Remove="Resources\Images\kissy.gif" />
	</ItemGroup>

	<ItemGroup>
	  <MauiAsset Include="Resources\Images\kissy.gif">
	    <LogicalName>%(Filename)%(Extension)</LogicalName>
	  </MauiAsset>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.100" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.100" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Verdure.Assistant.ViewModels\Verdure.Assistant.ViewModels.csproj" />
	  <ProjectReference Include="..\Verdure.Assistant.Core\Verdure.Assistant.Core.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidResource Include="Platforms\Android\Resources\**\*" />
	</ItemGroup>

</Project>
