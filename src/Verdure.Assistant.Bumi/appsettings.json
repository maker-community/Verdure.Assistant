{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Verdure.Assistant": "Information"
    }
  },
  "Urls": "http://0.0.0.0:5031",
  "AllowedHosts": "*",

  "ServerUrl": "wss://api.tenclass.net/xiaozhi/v1/",
  "UseWebSocket": true,
  "EnableVoice": true,
  "AudioSampleRate": 16000,
  "AudioChannels": 1,
  "AudioFormat": "opus",
  "EnableTemperatureSensor": false,

  "AutoStartVoiceChat": true,
  "AutoConversationMode": true,
  "WakeWordStart": true,
  "WakeCueEnabled": true,
  "EnableLocalKeywordSpotting": false,

  "KeywordModels": {
    "ModelsPath": "ModelFiles",
    "CurrentModel": "keyword_xiaodian.table"
  },

  "Bumi": {
    "DdsConfigPath": "config/dds.xml",
    "Volume": 100,
    "OutputGainDb": 1,
    "HighPassHz": 150,
    "PresenceHz": 2500,
    "PresenceGainDb": 6,
    "LimiterCeilingDb": -3,
    "PlaybackFrameMs": 20,
    "MuteBuiltInAgent": true,
    "MuteAudioCue": true,
    "KeepBuiltInAgentAsleep": true,
    "RestoreOnExit": true
  }
}
