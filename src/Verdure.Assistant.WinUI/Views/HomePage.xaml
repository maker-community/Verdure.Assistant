                                </StackPanel>
                            </Border>-->

                            <!--  Enhanced TTS Status Display  -->
                            <Border
                                Padding="16,12"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                CornerRadius="12"
                                BorderBrush="{ThemeResource SystemAccentColorLight1}"
                                BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE720;" Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemAccentColorDark1}"
                                            Text="语音状态" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="TtsText"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{ThemeResource SystemAccentColorDark1}"
                                            Text="{x:Bind ViewModel.TtsText, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!--  Music Center - Compact Modern Design  -->
                    <Border
                        x:Name="MusicCenter"
                        Grid.Column="4"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock 
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    Text="🎵 音乐播放" />
                                <Rectangle 
                                    Height="1" 
                                    HorizontalAlignment="Center"
                                    Width="60"
                                    Fill="{ThemeResource SystemAccentColorLight1}"
                                    RadiusX="0.5" RadiusY="0.5" />
                            </StackPanel>

                            <!--  Music Player Section - Compact  -->
                            <StackPanel Spacing="12">
                                <!--  Song Info Card  -->
                                <Border
                                    Padding="12,10"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{ThemeResource SystemAccentColorLight2}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{x:Bind ViewModel.CurrentSongName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!--  Progress Slider  -->
                                <Slider
                                    x:Name="MusicProgressSlider"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="{x:Bind ViewModel.MusicDuration, Mode=OneWay}"
                                    Minimum="0"
                                    PointerReleased="MusicProgressSlider_PointerReleased"
                                    Value="{x:Bind ViewModel.MusicPosition, Mode=OneWay}" />

                                <!--  Compact Controls  -->
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button
                                            x:Name="PlayPauseButton"
                                            Width="40"
                                            Height="40"
                                            Click="PlayPauseButton_Click"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            CornerRadius="20">
                                            <FontIcon
                                                x:Name="PlayPauseIcon"
                                                FontSize="16"
                                                Glyph="&#xE768;" />
                                        </Button>

                                        <Button
                                            x:Name="StopMusicButton"
                                            Width="40"
                                            Height="40"
                                            Command="{x:Bind ViewModel.StopMusicCommand}"
                                            CornerRadius="20">
                                            <FontIcon x:Name="StopMusicIcon" FontSize="16" Glyph="&#xE71A;" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.MusicStatus, Mode=OneWay}" />
                                </StackPanel>

                                <!--  Current Lyric  -->
                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource SystemAccentColorLight3}"
                                    CornerRadius="8">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Text="{x:Bind ViewModel.CurrentLyric, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>                
            </Grid>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>            
            <VisualStateGroup x:Name="AdaptiveStates">
                <!-- Extra Wide State - For very large screens -->
                <VisualState x:Name="ExtraWideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainScrollViewer.Padding" Value="40,20" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[0].Width" Value="1.2*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[2].Width" Value="2.5*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[4].Width" Value="1.2*" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Wide State - Standard desktop -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainScrollViewer.Padding" Value="24,16" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[0].Width" Value="1*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[2].Width" Value="2*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[4].Width" Value="1*" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Medium State - Small desktop/large tablet -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainScrollViewer.Padding" Value="16,12" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[0].Width" Value="0.8*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[2].Width" Value="2.5*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[4].Width" Value="0.8*" />
                        <Setter Target="HeaderSection.Margin" Value="0,0,0,16" />
                        <Setter Target="DashboardGrid.Margin" Value="0,0,0,16" />
                        
                        <!-- Adjust emotion center for medium screens -->
                        <Setter Target="EmotionStatusCard.Padding" Value="16" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Tablet State - Standard tablet -->
                <VisualState x:Name="TabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainScrollViewer.Padding" Value="12,8" />
                        
                        <!-- Modify grid for tablet layout -->
                        <Setter Target="DashboardGrid.RowDefinitions" Value="Auto,Auto" />
                        <Setter Target="DashboardGrid.ColumnDefinitions" Value="*,16,*" />
                        
                        <!-- Emotion center spans full width on top -->
                        <Setter Target="EmotionStatusCard.(Grid.Column)" Value="0" />
                        <Setter Target="EmotionStatusCard.(Grid.Row)" Value="0" />
                        <Setter Target="EmotionStatusCard.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="EmotionStatusCard.Padding" Value="20,16" />
                        
                        <!-- Side panels on bottom row -->
                        <Setter Target="SystemStatusCard.(Grid.Column)" Value="0" />
                        <Setter Target="SystemStatusCard.(Grid.Row)" Value="1" />
                        <Setter Target="MusicCenter.(Grid.Column)" Value="2" />
                        <Setter Target="MusicCenter.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Mobile State - Small tablet/large phone -->
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainScrollViewer.Padding" Value="8,6" />
                        
                        <!-- Stack all cards vertically -->
                        <Setter Target="DashboardGrid.RowDefinitions" Value="Auto,Auto,Auto" />
                        <Setter Target="DashboardGrid.ColumnDefinitions" Value="*" />
                        
                        <!-- All cards in single column -->
                        <Setter Target="EmotionStatusCard.(Grid.Column)" Value="0" />
                        <Setter Target="EmotionStatusCard.(Grid.Row)" Value="0" />
                        <Setter Target="EmotionStatusCard.Padding" Value="16,12" />
                        
                        <Setter Target="SystemStatusCard.(Grid.Column)" Value="0" />
                        <Setter Target="SystemStatusCard.(Grid.Row)" Value="1" />
                        
                        <Setter Target="MusicCenter.(Grid.Column)" Value="0" />
                        <Setter Target="MusicCenter.(Grid.Row)" Value="2" />
                        
                        <!-- Compact styling for mobile -->
                        <Setter Target="HeaderSection.Margin" Value="0,0,0,12" />
                        <Setter Target="DashboardGrid.Margin" Value="0,0,0,12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
