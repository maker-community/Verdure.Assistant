<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Verdure.Assistant.WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Verdure.Assistant.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Converters  -->
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  Emotion Animations  -->
        <Storyboard x:Key="EmotionPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmotionScaleTransform" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmotionScaleTransform" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="EmotionBounceAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmotionScaleTransform" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmotionScaleTransform" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--  Styles  -->        
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource SystemAccentColor}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="AccentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemAccentColorLight2}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!--  Responsive Layout Templates  -->
        <DataTemplate x:Key="CompactMusicTemplate">
            <StackPanel Spacing="12">
                <!--  Compact Music Search  -->
                <TextBox
                    x:Name="CompactMusicSearchTextBox"
                    Height="44"
                    FontSize="14"
                    PlaceholderText="搜索音乐..." />
                <Button
                    x:Name="CompactSearchMusicButton"
                    Height="44"
                    HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                        <TextBlock FontWeight="SemiBold" Text="搜索音乐" />
                    </StackPanel>
                </Button>

                <!--  Compact Player Info  -->
                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="当前播放"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="歌曲信息"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>        <!--  Compact Card Style for smaller screens  -->
        <Style x:Key="CompactCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer
            x:Name="MainScrollViewer"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header Section: Status & Connection  -->
                <Grid
                    x:Name="HeaderSection"
                    Grid.Row="0"
                    Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!--  Status Card  -->
                    <Border Grid.Column="0" Style="{StaticResource AccentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>                            
                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Border
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="20">
                                    <FontIcon
                                        x:Name="StatusIcon"
                                        FontSize="20"
                                        Foreground="White"
                                        Glyph="&#xE916;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemAccentColorDark1}"
                                        Text="语音助手状态" />
                                    <TextBlock
                                        x:Name="StatusText"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource SystemAccentColorDark2}"
                                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        x:Name="ConnectionIndicator"
                                        Width="12"
                                        Height="12"
                                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}">
                                        <!-- Add a subtle animation for better visibility -->
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            x:Name="ConnectionStatusText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemAccentColorDark1}"
                                            Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="连接状态" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>                    <!--  Keyword Wake Status  -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="14"
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="唤醒状态" />

                            <StackPanel Spacing="8">
                                <Border
                                    Padding="12,8"
                                    Background="{ThemeResource SystemAccentColorLight3}"
                                    CornerRadius="6">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource SystemAccentColorDark1}"
                                            Text="关键词唤醒" />
                                        <TextBlock
                                            x:Name="KeywordWakeStatusText"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource SystemAccentColorDark2}"
                                            Text="{x:Bind ViewModel.KeywordWakeStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="8,6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="11"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.KeywordWakePromptText, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>                
                <!--  Verification Code Section  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Background="{ThemeResource SystemFillColorCautionBrush}"
                    BorderBrush="{ThemeResource SystemAccentColor}"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsVerificationCodeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="{ThemeResource SystemAccentColor}"
                                CornerRadius="20">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="White"
                                    Glyph="&#xE72E;" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="身份验证" />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="需要验证身份以继续使用服务" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Width="36"
                                Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.DismissVerificationCodeCommand}"
                                CornerRadius="18">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <!--  Message  -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,20"
                            FontSize="14"
                            Text="{x:Bind ViewModel.VerificationCodeMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <!--  Code Display and Actions  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="20,16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    Text="{x:Bind ViewModel.VerificationCode, Mode=OneWay}" />
                            </Border>

                            <Button
                                Grid.Column="2"
                                Height="48"
                                Command="{x:Bind ViewModel.CopyVerificationCodeCommand}"
                                Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                    <TextBlock Text="复制" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="4"
                                Height="48"
                                Command="{x:Bind ViewModel.OpenLoginPageCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE774;" />
                                    <TextBlock Text="打开登录页" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>                
                <!--  Main Dashboard Section  -->
                <Grid
                    x:Name="DashboardGrid"
                    Grid.Row="2"
                    Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>                    <!--  System Status Card  -->
                    <Border
                        x:Name="SystemStatusCard"
                        Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="📊 系统状态" />

                            <StackPanel Spacing="8">
                                <Border
                                    Padding="8,6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="系统运行状态" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.SystemStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="8,6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="物联网设备" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.IotStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!--  Enhanced Emotion Status Card - Featured Center  -->
                    <Border
                        x:Name="EmotionStatusCard"
                        Grid.Column="2"
                        Style="{StaticResource AccentCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock 
                                Style="{StaticResource SectionHeaderStyle}" 
                                Text="😊 情感状态中心"
                                FontSize="18"
                                HorizontalAlignment="Center" />

                            <!-- Main Emotion Display -->
                            <Border
                                Padding="24"
                                Background="{ThemeResource SystemAccentColorLight2}"
                                CornerRadius="16"
                                BorderBrush="{ThemeResource SystemAccentColor}"
                                BorderThickness="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Emotion Animation Container -->
                                    <Viewbox 
                                        Grid.Row="0"
                                        Width="120" 
                                        Height="120" 
                                        HorizontalAlignment="Center">
                                        <Grid>
                                            <!-- GIF显示控件 -->
                                            <Image
                                                x:Name="EmotionImage"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed" />
                                            
                                            <!-- 文本表情显示控件 with Animation -->
                                            <TextBlock
                                                x:Name="DefaultEmotionText"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="96"
                                                Text="{x:Bind ViewModel.CurrentEmotion, Mode=OneWay}">
                                                <TextBlock.RenderTransform>
                                                    <ScaleTransform x:Name="EmotionScaleTransform" ScaleX="1" ScaleY="1" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </Viewbox>
                                    
                                    <!-- Status Indicator -->
                                    <Border
                                        Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="12,8"
                                        Background="{ThemeResource SystemAccentColorLight1}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemAccentColorDark2}"
                                            Text="{x:Bind ViewModel.EmotionStatusText, Mode=OneWay}"
                                            HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 表情测试按钮 - 重新设计 -->
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Text="情感测试" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                        <Button x:Name="TestHappyButton" Content="😊" Width="48" Height="48" 
                                                Click="TestHappyButton_Click" Style="{ThemeResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="开心" />
                                        <Button x:Name="TestSadButton" Content="😢" Width="48" Height="48" 
                                                Click="TestSadButton_Click" ToolTipService.ToolTip="难过" />
                                        <Button x:Name="TestAngryButton" Content="😠" Width="48" Height="48" 
                                                Click="TestAngryButton_Click" ToolTipService.ToolTip="愤怒" />
                                        <Button x:Name="TestNeutralButton" Content="😐" Width="48" Height="48" 
                                                Click="TestNeutralButton_Click" ToolTipService.ToolTip="平静" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  TTS Text Display - Enhanced  -->
                            <Border
                                Padding="12,8"
                                Background="{ThemeResource SystemAccentColorLight3}"
                                CornerRadius="8">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource SystemAccentColorDark1}"
                                        Text="语音状态" />
                                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="TtsText"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemAccentColorDark1}"
                                            Text="{x:Bind ViewModel.TtsText, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!--  Music Center - Simplified  -->
                    <Border
                        x:Name="MusicCenter"
                        Grid.Column="4"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="🎵 音乐播放" />

                            <!--  Music Player Section - Compact  -->
                            <StackPanel Spacing="8">
                                <!--  Song Info  -->
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{x:Bind ViewModel.CurrentSongName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!--  Progress Slider  -->
                                <Slider
                                    x:Name="MusicProgressSlider"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="{x:Bind ViewModel.MusicDuration, Mode=OneWay}"
                                    Minimum="0"
                                    PointerReleased="MusicProgressSlider_PointerReleased"
                                    Value="{x:Bind ViewModel.MusicPosition, Mode=OneWay}" />
                                    
                                <!--  Compact Controls  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="PlayPauseButton"
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,6,0"
                                        Click="PlayPauseButton_Click"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <FontIcon
                                            x:Name="PlayPauseIcon"
                                            FontSize="12"
                                            Glyph="&#xE768;" />
                                    </Button>
                                    
                                    <Button
                                        x:Name="StopMusicButton"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Command="{x:Bind ViewModel.StopMusicCommand}">
                                        <FontIcon x:Name="StopMusicIcon" FontSize="12" Glyph="&#xE71A;" />
                                    </Button>
                                    
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.MusicStatus, Mode=OneWay}" />
                                </Grid>

                                <!--  Current Lyric  -->
                                <Border
                                    Padding="8,6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Text="{x:Bind ViewModel.CurrentLyric, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>                
                <!--  Voice Control & Chat Section - Hidden as per requirements  -->
                <!-- 
                <Grid x:Name="VoiceControlGrid" Grid.Row="3" Visibility="Collapsed">
                    ... Voice Control and Chat content hidden ...
                </Grid>
                -->
            </Grid>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>            
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Use full layout for wide screens  -->
                        <Setter Target="MainScrollViewer.Padding" Value="20" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Adjust dashboard column layout for medium screens  -->
                        <Setter Target="DashboardGrid.ColumnDefinitions[0].Width" Value="1*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[2].Width" Value="2*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[4].Width" Value="1*" />
                        <Setter Target="MainScrollViewer.Padding" Value="16" />
                        <!--  Reduce margins for medium screens  -->
                        <Setter Target="HeaderSection.Margin" Value="0,0,0,12" />
                        <Setter Target="DashboardGrid.Margin" Value="0,0,0,12" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Stack cards vertically on narrow screens  -->
                        <Setter Target="DashboardGrid.RowDefinitions[0].Height" Value="Auto" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[1].Width" Value="0" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[2].Width" Value="0" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[3].Width" Value="0" />
                        <Setter Target="DashboardGrid.ColumnDefinitions[4].Width" Value="0" />

                        <!--  Reposition cards for narrow layout  -->
                        <Setter Target="SystemStatusCard.(Grid.Column)" Value="0" />
                        <Setter Target="SystemStatusCard.(Grid.Row)" Value="0" />
                        <Setter Target="EmotionStatusCard.(Grid.Column)" Value="0" />
                        <Setter Target="EmotionStatusCard.(Grid.Row)" Value="1" />
                        <Setter Target="MusicCenter.(Grid.Column)" Value="0" />
                        <Setter Target="MusicCenter.(Grid.Row)" Value="2" />

                        <!--  Compact styling for narrow screens  -->
                        <Setter Target="MainScrollViewer.Padding" Value="12" />
                        <Setter Target="HeaderSection.Margin" Value="0,0,0,8" />
                        <Setter Target="DashboardGrid.Margin" Value="0,0,0,8" />
                        <Setter Target="SystemStatusCard.Style" Value="{StaticResource CompactCardStyle}" />
                        <Setter Target="EmotionStatusCard.Style" Value="{StaticResource CompactCardStyle}" />
                        <Setter Target="MusicCenter.Style" Value="{StaticResource CompactCardStyle}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
