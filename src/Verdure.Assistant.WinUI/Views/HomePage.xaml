<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Verdure.Assistant.WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Verdure.Assistant.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Verdure.Assistant.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--  情感头像：切换表情时的弹跳动画  -->
        <Storyboard x:Key="EmotionBounceAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmotionTransform" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.86" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.08">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EmotionTransform" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.86" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.08">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--  聆听/播放时外圈的呼吸光晕  -->
        <Storyboard x:Key="EmotionPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingTransform" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.96" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1.06">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.96">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RingTransform" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.96" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1.06">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.96">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!--  卡片与文字样式  -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RoundIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" SizeChanged="PageRoot_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="RootLayout"
            HorizontalAlignment="Center"
            Padding="28,20,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ================= 激活验证码提示 ================= -->
            <Border
                x:Name="VerificationCard"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,20"
                Padding="20"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.IsVerificationCodeVisible, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="设备需要激活" />
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.VerificationCodeMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.VerificationCode, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CopyVerificationCodeCommand}"
                            Content="复制验证码" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.OpenLoginPageCommand}"
                            Content="打开激活页面" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.DismissVerificationCodeCommand}"
                            Content="稍后再说" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ================= 主区域：助手 + 对话记录 ================= -->
            <StackPanel
                x:Name="MainPanel"
                Grid.Row="1"
                Grid.Column="0"
                Spacing="20">

                <!--  助手卡片  -->
                <Border Padding="24" Style="{StaticResource PanelCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  顶部：状态胶囊 + 启动/停止  -->
                        <Grid Grid.Row="0">
                            <Border
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse
                                        x:Name="StateDot"
                                        Width="9"
                                        Height="9"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.PhaseText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    ToolTipService.ToolTip="选择语音对话使用的后端：唤醒词、连续对话、按住说话都按它执行"
                                    Visibility="{x:Bind ViewModel.IsDeepSeekAvailable}">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE9D9;" />
                                    <ComboBox
                                        x:Name="BackendComboBox"
                                        MinWidth="104"
                                        AutomationProperties.Name="语音对话后端"
                                        ItemsSource="{x:Bind ViewModel.BackendChoices}"
                                        SelectedIndex="{x:Bind ViewModel.BackendIndex, Mode=TwoWay}" />
                                </StackPanel>
                                <Button
                                    Command="{x:Bind ViewModel.ConnectCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsConnectButtonEnabled, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind conv:UiFormat.Hide(ViewModel.IsServiceReady), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                                        <TextBlock Text="启动" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.DisconnectCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsDisconnectButtonEnabled, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsServiceReady, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE7E8;" />
                                        <TextBlock Text="停止服务" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  情感头像  -->
                        <Grid
                            Grid.Row="1"
                            Width="210"
                            Height="210"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center">
                            <Ellipse
                                x:Name="RingOuter"
                                Width="210"
                                Height="210"
                                Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                RenderTransformOrigin="0.5,0.5"
                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                StrokeThickness="2">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform x:Name="RingTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse
                                Width="172"
                                Height="172"
                                Fill="{ThemeResource LayerFillColorDefaultBrush}"
                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                StrokeThickness="1" />
                            <Grid
                                Width="130"
                                Height="130"
                                RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="EmotionTransform" />
                                </Grid.RenderTransform>
                                <Image
                                    x:Name="EmotionImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="DefaultEmotionText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="84"
                                    Text="{x:Bind ViewModel.CurrentEmotion, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <!--  状态标题  -->
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                x:Name="StateTitle"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="{x:Bind ViewModel.KeywordWakePromptText, Mode=OneWay}"
                                TextAlignment="Center" />
                        </StackPanel>

                        <!--  助手回复气泡  -->
                        <Border
                            Grid.Row="3"
                            MaxWidth="620"
                            Margin="0,8,0,0"
                            Padding="16,12"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="助手回复" />
                                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.TtsText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!--  操作区  -->
                        <StackPanel
                            Grid.Row="4"
                            Margin="0,12,0,0"
                            Spacing="14">
                            <Grid ColumnSpacing="20" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="AutoDialogButton"
                                    Grid.Column="0"
                                    MinWidth="132"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.ToggleAutoModeCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsServiceReady, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="{x:Bind conv:UiFormat.AutoDialogGlyph(ViewModel.UiPhase), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind conv:UiFormat.AutoDialogText(ViewModel.UiPhase), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>

                                <!--  按住说话  -->
                                <Button
                                    x:Name="TalkButton"
                                    Grid.Column="1"
                                    Width="76"
                                    Height="76"
                                    Padding="0"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="0"
                                    CornerRadius="38"
                                    IsEnabled="{x:Bind ViewModel.IsServiceReady, Mode=OneWay}"
                                    PointerCaptureLost="ManualButton_PointerCaptureLost"
                                    ToolTipService.ToolTip="按住说话，松开发送"
                                    AutomationProperties.Name="按住说话">
                                    <FontIcon
                                        FontSize="30"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE720;" />
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    MinWidth="132"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AbortCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAbort, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE71A;" />
                                        <TextBlock Text="打断" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind conv:UiFormat.TalkHint(ViewModel.UiPhase), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  对话记录  -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CardTitleStyle}"
                                Text="对话与事件记录" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ClearMessagesCommand}"
                                Content="清空"
                                Visibility="{x:Bind conv:UiFormat.ShowWhenAny(ViewModel.Messages.Count), Mode=OneWay}" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <StackPanel
                                Padding="0,28"
                                HorizontalAlignment="Center"
                                Spacing="6"
                                Visibility="{x:Bind conv:UiFormat.ShowWhenZero(ViewModel.Messages.Count), Mode=OneWay}">
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8BD;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="还没有记录" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="说出唤醒词或按住麦克风开始对话" />
                            </StackPanel>

                            <ListView
                                x:Name="MessagesList"
                                MaxHeight="320"
                                ItemsSource="{x:Bind ViewModel.Messages}"
                                SelectionMode="None"
                                Visibility="{x:Bind conv:UiFormat.ShowWhenAny(ViewModel.Messages.Count), Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="4,6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind conv:UiFormat.Time(Timestamp)}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Content}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind conv:UiFormat.Hide(IsError)}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Content}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind IsError}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  ================= 侧栏：唤醒 / 音乐 / 系统 ================= -->
            <StackPanel
                x:Name="SidePanel"
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,20,0,0"
                Spacing="20">

                <!--  语音唤醒  -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="语音唤醒" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="22">
                                <FontIcon FontSize="20" Glyph="&#xE720;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.KeywordWakeStatusText, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="{x:Bind ViewModel.KeywordWakePromptText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ToggleKeywordDetectionCommand}"
                            Content="开启 / 关闭唤醒词"
                            IsEnabled="{x:Bind ViewModel.IsServiceReady, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!--  音乐播放  -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="音乐" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="64"
                                Height="64"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10">
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE8D6;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="{x:Bind conv:UiFormat.OrDash(ViewModel.CurrentSongName), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="{x:Bind ViewModel.CurrentArtist, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="2">
                            <Slider
                                x:Name="MusicProgressSlider"
                                IsEnabled="{x:Bind ViewModel.HasMusic, Mode=OneWay}"
                                Maximum="{x:Bind ViewModel.MusicDuration, Mode=OneWay}"
                                PointerReleased="MusicProgressSlider_PointerReleased"
                                Value="{x:Bind ViewModel.MusicPosition, Mode=OneWay}" />
                            <Grid>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.MusicTimeText, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.MusicStatus, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                Command="{x:Bind ViewModel.PreviousMusicCommand}"
                                Style="{StaticResource RoundIconButtonStyle}"
                                ToolTipService.ToolTip="上一首">
                                <FontIcon FontSize="16" Glyph="&#xE892;" />
                            </Button>
                            <Button
                                x:Name="PlayPauseButton"
                                Width="48"
                                Height="48"
                                Padding="0"
                                Click="PlayPauseButton_Click"
                                CornerRadius="24"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="播放 / 暂停">
                                <FontIcon
                                    x:Name="PlayPauseIcon"
                                    FontSize="20"
                                    Glyph="{x:Bind ViewModel.MusicPlayGlyph, Mode=OneWay}" />
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.NextMusicCommand}"
                                Style="{StaticResource RoundIconButtonStyle}"
                                ToolTipService.ToolTip="下一首">
                                <FontIcon FontSize="16" Glyph="&#xE893;" />
                            </Button>
                            <Button
                                x:Name="StopMusicButton"
                                Command="{x:Bind ViewModel.StopMusicCommand}"
                                Style="{StaticResource RoundIconButtonStyle}"
                                ToolTipService.ToolTip="停止">
                                <FontIcon FontSize="16" Glyph="&#xE71A;" />
                            </Button>
                        </StackPanel>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentLyric, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  系统状态  -->
                <Border Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="系统" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE950;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontSize="12" Style="{StaticResource MutedTextStyle}" Text="系统状态" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind conv:UiFormat.OrDash(ViewModel.SystemStatusText), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE957;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontSize="12" Style="{StaticResource MutedTextStyle}" Text="物联网设备" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind conv:UiFormat.OrDash(ViewModel.IotStatusText), Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <!--  布局：宽屏时侧栏在右侧，窄屏时堆叠在下方  -->
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="380" />
                        <Setter Target="RootLayout.ColumnSpacing" Value="20" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="1" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="1" />
                        <Setter Target="SidePanel.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowLayout" />
            </VisualStateGroup>

            <!--  对话阶段：状态点/外圈/标题的颜色随阶段变化  -->
            <VisualStateGroup x:Name="PhaseStates">
                <VisualState x:Name="Offline" />
                <VisualState x:Name="Idle">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Connecting">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="RingOuter.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Listening">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="RingOuter.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="RingOuter.StrokeThickness" Value="3" />
                        <Setter Target="StateTitle.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Speaking">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                        <Setter Target="RingOuter.Stroke" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                        <Setter Target="RingOuter.StrokeThickness" Value="3" />
                        <Setter Target="StateTitle.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
