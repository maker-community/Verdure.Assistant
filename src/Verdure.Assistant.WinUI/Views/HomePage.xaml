                            <StackPanel Spacing="8">
                                <TextBlock 
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource SystemAccentColorDark2}"
                                    Text="✨ 情感中心" />
                                <Rectangle 
                                    Height="2" 
                                    HorizontalAlignment="Center"
                                    Width="80"
                                    Fill="{ThemeResource SystemAccentColor}"
                                    RadiusX="1" RadiusY="1" />
                            </StackPanel>

                            <!-- Main Emotion Display with Enhanced Animation -->
                            <Border
                                Padding="32"
                                Background="{ThemeResource SystemAccentColorLight1}"
                                CornerRadius="20"
                                BorderBrush="{ThemeResource SystemAccentColorDark1}"
                                BorderThickness="1">
                                <Border.Shadow>
                                    <ThemeShadow/>
                                </Border.Shadow>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Emotion Animation Container -->
                                    <Viewbox 
                                        Grid.Row="0"
                                        Width="140" 
                                        Height="140" 
                                        HorizontalAlignment="Center">
                                        <Grid>
                                            <!-- Background Circle for Pulse Effect -->
                                            <Ellipse
                                                x:Name="EmotionBackgroundCircle"
                                                Fill="{ThemeResource SystemAccentColorLight3}"
                                                Opacity="0.3"
                                                Width="120"
                                                Height="120" />
                                            
                                            <!-- GIF显示控件 -->
                                            <Image
                                                x:Name="EmotionImage"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed" />
                                            
                                            <!-- 文本表情显示控件 with Enhanced Animation -->
                                            <TextBlock
                                                x:Name="DefaultEmotionText"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="96"
                                                Text="{x:Bind ViewModel.CurrentEmotion, Mode=OneWay}">
                                            </TextBlock>
                                        </Grid>
                                    </Viewbox>
                                    
                                    <!-- Enhanced Status Indicator -->
                                    <Border
                                        Grid.Row="1"
                                        Margin="0,20,0,0"
                                        Padding="16,10"
                                        Background="{ThemeResource SystemAccentColor}"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind ViewModel.EmotionStatusText, Mode=OneWay}"
                                            HorizontalAlignment="Center" />
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                    </Border>
                                </Grid>
                            </Border>

