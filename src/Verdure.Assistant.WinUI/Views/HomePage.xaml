                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>                    <!--  System Status Card - Modern Minimalist  -->
                    <Border
                        x:Name="SystemStatusCard"
                        Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock 
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    Text="📊 系统监控" />
                                <Rectangle 
                                    Height="1" 
                                    HorizontalAlignment="Center"
                                    Width="60"
                                    Fill="{ThemeResource SystemAccentColorLight1}"
                                    RadiusX="0.5" RadiusY="0.5" />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <Border
                                    Padding="12,10"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{ThemeResource SystemAccentColorLight2}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE950;" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="系统状态" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.SystemStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Padding="12,10"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{ThemeResource SystemAccentColorLight2}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE968;" Foreground="{ThemeResource SystemAccentColor}" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="物联网设备" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.IotStatusText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
