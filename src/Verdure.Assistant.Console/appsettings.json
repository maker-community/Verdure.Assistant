{
  "ServerUrl": "wss://api.tenclass.net/xiaozhi/v1/",
  "MqttBroker": "localhost",
  "MqttPort": 1883,
  "MqttClientId": "xiaozhi_dotnet_client",
  "MqttTopic": "xiaozhi/chat",
  "UseWebSocket": true,
  "EnableVoice": true,
  "AudioSampleRate": 16000,
  "AudioChannels": 1,
  "AudioFormat": "opus",
  "EnableTemperatureSensor": false,
  "TemperatureSensorPin": "A0",

  "AudioBackend": "default",
  "Bumi": {
    "DdsConfigPath": "config/dds.xml",
    "Volume": 120,
    "OutputGainDb": -6,
    "HighPassHz": 250,
    "PlaybackFrameMs": 20,
    "MuteBuiltInAgent": true
  }
}